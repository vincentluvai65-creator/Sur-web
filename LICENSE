const express = require('express');
const http = require('http');
const { Server } = require('socket.io');

const app = express();
const server = http.createServer(app);
const io = new Server(server);

// Serve static HTML files from a "public" folder
app.use(express.static('public'));

// Server Game State
let gameState = 'WAITING'; // WAITING, FLYING, CRASHED
let multiplier = 1.00;
let crashPoint = 1.00;
let startTime = 0;

// Store connected players (In production, use a real database like PostgreSQL or MongoDB)
const players = {};

function generateCrashPoint() {
  const r = Math.random();
  if (r < 0.04) return 1.00;
  const crash = 0.96 / (1 - r);
  return parseFloat(Math.max(1.01, Math.min(crash, 250)).toFixed(2));
}

function startWaitingPhase() {
  gameState = 'WAITING';
  multiplier = 1.00;
  io.emit('gameState', { state: 'WAITING', countdown: 5 });

  setTimeout(startFlight, 5000);
}

function startFlight() {
  gameState = 'FLYING';
  crashPoint = generateCrashPoint();
  startTime = Date.now();
  io.emit('gameState', { state: 'FLYING' });

  const flightInterval = setInterval(() => {
    const elapsedSeconds = (Date.now() - startTime) / 1000;
    multiplier = parseFloat(Math.pow(Math.E, 0.085 * elapsedSeconds).toFixed(2));

    if (multiplier >= crashPoint) {
      clearInterval(flightInterval);
      endFlight();
    } else {
      io.emit('tick', { multiplier });
    }
  }, 50); // Broadcasts 20 times per second
}

function endFlight() {
  gameState = 'CRASHED';
  io.emit('gameState', { state: 'CRASHED', crashPoint });

  // Reset active bets for players who didn't cash out
  for (const id in players) {
    players[id].currentBet = 0;
  }

  setTimeout(startWaitingPhase, 3000);
}

// Handle Player Connections
io.on('connection', (socket) => {
  console.log('Player connected:', socket.id);

  // Give new player 1000 virtual demo points
  players[socket.id] = { balance: 1000, currentBet: 0 };
  socket.emit('balanceUpdate', players[socket.id].balance);

  // Handle incoming bet
  socket.on('placeBet', (amount) => {
    const player = players[socket.id];
    const bet = parseFloat(amount);

    if (gameState === 'WAITING' && player.currentBet === 0 && bet >= 10 && bet <= player.balance) {
      player.balance -= bet;
      player.currentBet = bet;
      socket.emit('balanceUpdate', player.balance);
      socket.emit('betConfirmed', bet);
      io.emit('playerAction', `${socket.id.slice(0, 5)} bet KES ${bet}`);
    }
  });

  // Handle cashout request
  socket.on('cashOut', () => {
    const player = players[socket.id];
    if (gameState === 'FLYING' && player.currentBet > 0) {
      const winnings = parseFloat((player.currentBet * multiplier).toFixed(2));
      player.balance += winnings;
      player.currentBet = 0;
      socket.emit('balanceUpdate', player.balance);
      socket.emit('cashOutSuccess', { multiplier, winnings });
      io.emit('playerAction', `${socket.id.slice(0, 5)} cashed out @ ${multiplier}x!`);
    }
  });

  socket.on('disconnect', () => {
    delete players[socket.id];
    console.log('Player disconnected:', socket.id);
  });
});

// Start server and game loop
server.listen(3000, () => {
  console.log('Multiplayer server running on http://localhost:3000');
  startWaitingPhase();
});
